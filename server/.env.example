# Database Configuration
POSTGRES_USER=server_user
POSTGRES_PASSWORD=server_password
POSTGRES_DB=server_db

# Database URL for application
DATABASE_URL=postgresql+asyncpg://server_user:server_password@server_db:5432/server_db

# Monitoring System Configuration
MONITORING_SYSTEM_URL=http://monitoring_system:8000
API_KEY=your-api-key-here

# Application Configuration
DEBUG=False
LOG_LEVEL=INFO

